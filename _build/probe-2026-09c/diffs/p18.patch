index 0000000..687b081
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,94 @@
+import io
+import unittest
+from contextlib import redirect_stdout
+from datetime import date
+from pathlib import Path
+
+from app.report import main, realized_pnl
+from app.trades import Trade, load_trades
+
+DATA = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def trade(trade_id, day, ticker, side, qty, price, currency="USD", fee=0.0):
+    return Trade(trade_id, date.fromisoformat(day), ticker, side, qty, price, currency, fee)
+
+
+class TestRealizedPnl(unittest.TestCase):
+    def test_fifo_uses_buys_from_earlier_months_and_fees(self):
+        trades = [
+            trade(1, "2026-08-01", "X", "BUY", 10, 10.0, fee=2.0),  # 10.2 / share
+            trade(2, "2026-09-10", "X", "BUY", 10, 20.0),
+            trade(3, "2026-09-20", "X", "SELL", 15, 30.0, fee=3.0),
+        ]
+        # proceeds 450 - 3 = 447; cost 10 * 10.2 + 5 * 20 = 202
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 245.0})
+
+    def test_only_sells_of_the_month_count_but_earlier_sells_consume_lots(self):
+        trades = [
+            trade(1, "2026-08-01", "X", "BUY", 10, 10.0),
+            trade(2, "2026-08-15", "X", "SELL", 5, 12.0),
+            trade(3, "2026-09-01", "X", "BUY", 5, 100.0),
+            trade(4, "2026-09-20", "X", "SELL", 5, 15.0),  # FIFO: remaining 5 @ 10
+            trade(5, "2026-10-05", "X", "SELL", 5, 50.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 8), {"X": 10.0})
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 25.0})
+        self.assertEqual(realized_pnl(trades, 2026, 7), {})
+
+    def test_input_order_does_not_matter(self):
+        trades = [
+            trade(1, "2026-08-01", "X", "BUY", 10, 10.0),
+            trade(2, "2026-09-01", "X", "BUY", 10, 20.0),
+            trade(3, "2026-09-20", "X", "SELL", 10, 30.0),
+        ]
+        self.assertEqual(realized_pnl(list(reversed(trades)), 2026, 9), {"X": 200.0})
+
+    def test_converts_to_usd(self):
+        trades = [
+            trade(1, "2026-09-01", "S", "BUY", 10, 100.0, "EUR"),
+            trade(2, "2026-09-02", "S", "SELL", 10, 110.0, "EUR"),
+        ]
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["S"], 108.0)
+
+    def test_sell_without_known_cost_basis_is_none(self):
+        trades = [
+            trade(1, "2026-09-01", "X", "BUY", 2, 10.0),
+            trade(2, "2026-09-05", "X", "SELL", 3, 12.0),  # sells more than held
+            trade(3, "2026-09-06", "Y", "SELL", 1, 50.0),  # no buy at all
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": None, "Y": None})
+
+    def test_unknown_side_raises(self):
+        trades = [trade(1, "2026-09-01", "X", "SHORT", 1, 10.0)]
+        with self.assertRaises(ValueError):
+            realized_pnl(trades, 2026, 9)
+
+    def test_september_2026_from_csv(self):
+        pnl = realized_pnl(load_trades(DATA), 2026, 9)
+        self.assertEqual(set(pnl), {"AAPL", "SAP", "MAIB", "TSLA"})
+        # AAPL: 949 - 5*180.1 = 48.5; 1199 - (5*180.1 + 185.2) = 113.3
+        self.assertAlmostEqual(pnl["AAPL"], 161.8)
+        # SAP: (3198 - 3002) EUR * 1.08
+        self.assertAlmostEqual(pnl["SAP"], 211.68)
+        # MAIB: (5495 - 50*95.05) MDL / 17.8
+        self.assertAlmostEqual(pnl["MAIB"], 742.5 / 17.8)
+        # TSLA: sold without a buy in the file
+        self.assertIsNone(pnl["TSLA"])
+
+
+class TestCli(unittest.TestCase):
+    def test_prints_table_and_total(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            code = main(["2026", "9"])
+        text = out.getvalue()
+        self.assertEqual(code, 0)
+        self.assertIn("AAPL", text)
+        self.assertIn("н/д", text)
+        total = next(line for line in text.splitlines() if line.startswith("ИТОГО"))
+        self.assertTrue(total.endswith("415.19"), total)
+
+
+if __name__ == "__main__":
+    unittest.main()
