 """Portfolio reports."""
+
+import sys
+from collections import defaultdict, deque
+from pathlib import Path
+
+from app.fx import to_usd
+from app.trades import load_trades
+
+DATA = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def realized_pnl(trades, year, month):
+    """Realized profit in USD per ticker for sells made in the given month.
+
+    Cost basis is FIFO over all earlier trades (including buys from previous
+    months). Fees are included: a buy fee raises the lot's cost, a sell fee
+    reduces the proceeds. Fees are assumed to be in the trade's currency.
+
+    If a sell in the month exceeds the shares held according to the data
+    (for example, the buy happened before the export started), its cost basis
+    is unknown and the ticker's value is ``None`` instead of a number.
+    """
+    lots = defaultdict(deque)  # ticker -> deque of [qty, cost per share]
+    broken = set()  # tickers whose position the data does not cover
+    result = {}
+
+    for t in sorted(trades, key=lambda t: (t.date, t.trade_id)):
+        period = (t.date.year, t.date.month)
+        if period > (year, month):
+            break
+        in_month = period == (year, month)
+        if t.side == "BUY":
+            lots[t.ticker].append([t.qty, (t.qty * t.price + t.fee) / t.qty])
+            continue
+        if t.side != "SELL":
+            raise ValueError(f"trade {t.trade_id}: unknown side {t.side!r}")
+
+        held = sum(qty for qty, _ in lots[t.ticker])
+        if t.qty > held:
+            broken.add(t.ticker)
+        if t.ticker in broken:
+            lots[t.ticker].clear()
+            if in_month:
+                result[t.ticker] = None
+            continue
+
+        cost, left = 0.0, t.qty
+        queue = lots[t.ticker]
+        while left:
+            lot = queue[0]
+            take = min(left, lot[0])
+            cost += take * lot[1]
+            lot[0] -= take
+            left -= take
+            if lot[0] == 0:
+                queue.popleft()
+
+        if in_month:
+            pnl = to_usd(t.qty * t.price - t.fee - cost, t.currency)
+            result[t.ticker] = result.get(t.ticker, 0.0) + pnl
+
+    return result
+
+
+def format_report(pnl, year, month):
+    """Render the realized P&L table with a total line."""
+    lines = [f"Реализованная прибыль за {month:02d}.{year}, USD", ""]
+    width = max([len("Тикер"), len("ИТОГО")] + [len(k) for k in pnl])
+    lines.append(f"{'Тикер':<{width}}  {'P&L, USD':>12}")
+    unknown = []
+    for ticker in sorted(pnl):
+        value = pnl[ticker]
+        if value is None:
+            unknown.append(ticker)
+            lines.append(f"{ticker:<{width}}  {'н/д':>12}")
+        else:
+            lines.append(f"{ticker:<{width}}  {value:>12,.2f}")
+    total = sum(v for v in pnl.values() if v is not None)
+    lines.append(f"{'ИТОГО':<{width}}  {total:>12,.2f}")
+    if unknown:
+        lines.append("")
+        lines.append(
+            "н/д — продано больше, чем куплено по данным файла; "
+            "себестоимость неизвестна, в итог не входит: " + ", ".join(unknown)
+        )
+    return "\n".join(lines)
+
+
+def main(argv=None):
+    argv = sys.argv[1:] if argv is None else argv
+    if len(argv) != 2:
+        print("usage: python -m app.report YEAR MONTH", file=sys.stderr)
+        return 2
+    year, month = int(argv[0]), int(argv[1])
+    if not 1 <= month <= 12:
+        print(f"month must be 1..12, got {month}", file=sys.stderr)
+        return 2
+    print(format_report(realized_pnl(load_trades(DATA), year, month), year, month))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
