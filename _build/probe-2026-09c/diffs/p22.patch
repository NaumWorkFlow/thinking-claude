+++ b/tests/test_report.py
@@ -0,0 +1,134 @@
+import io
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from datetime import date
+from pathlib import Path
+
+from app.fx import to_usd
+from app.report import main, realized_pnl, unmatched_sales
+from app.trades import Trade, load_trades
+
+DATA = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def trade(trade_id, day, ticker, side, qty, price, currency="USD", fee=0.0):
+    return Trade(trade_id, date.fromisoformat(day), ticker, side, qty, price, currency, fee)
+
+
+class TestRealizedPnl(unittest.TestCase):
+    def test_simple_round_trip(self):
+        trades = [
+            trade(1, "2026-09-01", "AAA", "BUY", 10, 100.0),
+            trade(2, "2026-09-10", "AAA", "SELL", 10, 110.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"AAA": 100.0})
+
+    def test_fifo_takes_oldest_lot_first(self):
+        trades = [
+            trade(1, "2026-08-01", "AAA", "BUY", 5, 100.0),
+            trade(2, "2026-08-15", "AAA", "BUY", 5, 120.0),
+            trade(3, "2026-09-10", "AAA", "SELL", 6, 130.0),
+        ]
+        # cost = 5*100 + 1*120 = 620; proceeds = 780
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"AAA": 160.0})
+
+    def test_fees_reduce_profit(self):
+        trades = [
+            trade(1, "2026-09-01", "AAA", "BUY", 10, 100.0, fee=2.0),
+            trade(2, "2026-09-10", "AAA", "SELL", 5, 110.0, fee=1.0),
+        ]
+        # cost = 5 * (1002 / 10) = 501; proceeds = 550 - 1 = 549
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"AAA": 48.0})
+
+    def test_only_sells_of_the_month_count(self):
+        trades = [
+            trade(1, "2026-08-01", "AAA", "BUY", 10, 100.0),
+            trade(2, "2026-08-20", "AAA", "SELL", 4, 150.0),
+            trade(3, "2026-09-10", "AAA", "SELL", 6, 110.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"AAA": 60.0})
+        self.assertEqual(realized_pnl(trades, 2026, 8), {"AAA": 200.0})
+        self.assertEqual(realized_pnl(trades, 2026, 7), {})
+
+    def test_sell_outside_month_consumes_lots(self):
+        trades = [
+            trade(1, "2026-08-01", "AAA", "BUY", 5, 100.0),
+            trade(2, "2026-08-02", "AAA", "BUY", 5, 200.0),
+            trade(3, "2026-08-20", "AAA", "SELL", 5, 150.0),
+            trade(4, "2026-09-10", "AAA", "SELL", 5, 210.0),
+        ]
+        # August sale used the 100 lot, so September sells the 200 lot.
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"AAA": 50.0})
+
+    def test_input_order_does_not_matter(self):
+        trades = [
+            trade(2, "2026-09-10", "AAA", "SELL", 10, 110.0),
+            trade(1, "2026-09-01", "AAA", "BUY", 10, 100.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"AAA": 100.0})
+
+    def test_foreign_currency_converted_to_usd(self):
+        trades = [
+            trade(1, "2026-09-01", "BBB", "BUY", 10, 100.0, "EUR", fee=1.0),
+            trade(2, "2026-09-10", "BBB", "SELL", 10, 110.0, "EUR", fee=1.0),
+        ]
+        expected = round(to_usd(1099.0, "EUR") - to_usd(1001.0, "EUR"), 2)
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"BBB": expected})
+
+    def test_loss_is_negative(self):
+        trades = [
+            trade(1, "2026-09-01", "AAA", "BUY", 10, 100.0),
+            trade(2, "2026-09-10", "AAA", "SELL", 10, 90.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"AAA": -100.0})
+
+    def test_sell_without_buy_is_excluded_and_reported(self):
+        trades = [
+            trade(1, "2026-09-01", "AAA", "BUY", 10, 100.0),
+            trade(2, "2026-09-05", "AAA", "SELL", 10, 110.0),
+            trade(3, "2026-09-12", "ZZZ", "SELL", 3, 250.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"AAA": 100.0})
+        [(t, missing)] = unmatched_sales(trades, 2026, 9)
+        self.assertEqual((t.trade_id, missing), (3, 3))
+
+    def test_sell_larger_than_position_is_excluded(self):
+        trades = [
+            trade(1, "2026-09-01", "AAA", "BUY", 5, 100.0),
+            trade(2, "2026-09-05", "AAA", "SELL", 8, 110.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {})
+        [(t, missing)] = unmatched_sales(trades, 2026, 9)
+        self.assertEqual((t.trade_id, missing), (2, 3))
+
+    def test_unknown_side_raises(self):
+        with self.assertRaises(ValueError):
+            realized_pnl([trade(1, "2026-09-01", "AAA", "HOLD", 1, 1.0)], 2026, 9)
+
+    def test_on_broker_export(self):
+        pnl = realized_pnl(load_trades(DATA), 2026, 9)
+        self.assertEqual(set(pnl), {"AAPL", "SAP", "MAIB"})
+        # AAPL: (949 - 5*180.1) + (1199 - 5*180.1 - 185.2) = 48.5 + 113.3
+        self.assertEqual(pnl["AAPL"], 161.8)
+        self.assertEqual(pnl["SAP"], round(to_usd(3198.0 - 3002.0, "EUR"), 2))
+        self.assertEqual(pnl["MAIB"], round(to_usd(5495.0 - 4752.5, "MDL"), 2))
+        [(t, missing)] = unmatched_sales(load_trades(DATA), 2026, 9)
+        self.assertEqual((t.ticker, missing), ("TSLA", 3))
+
+
+class TestCli(unittest.TestCase):
+    def test_prints_table_and_total(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            main(["2026", "9"])
+        text = out.getvalue()
+        for ticker in ("AAPL", "SAP", "MAIB", "Итого", "TSLA"):
+            self.assertIn(ticker, text)
+
+    def test_rejects_bad_month(self):
+        with redirect_stderr(io.StringIO()), self.assertRaises(SystemExit):
+            main(["2026", "13"])
+
+
+if __name__ == "__main__":
+    unittest.main()
