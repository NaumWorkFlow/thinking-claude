@@ -1 +1,109 @@
 """Portfolio reports."""
+
+import argparse
+from collections import defaultdict, deque
+from pathlib import Path
+
+from app.fx import to_usd
+from app.trades import load_trades
+
+TRADES_CSV = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def _match_sales(trades, year, month):
+    """Match sells against earlier buys by FIFO.
+
+    Fees are part of the result: a buy fee is added to the cost of its shares,
+    a sell fee is subtracted from the proceeds. Every amount is converted to
+    USD with ``to_usd``.
+
+    Returns ``(pnl, unmatched)``: ``pnl`` maps ticker -> realized USD for sells
+    in the given month; ``unmatched`` lists ``(trade, missing_qty)`` for sells
+    in that month that exceed the position held (no buy in the data). Such a
+    sell has no known cost basis, so it is left out of ``pnl``.
+    """
+    lots = defaultdict(deque)  # ticker -> [qty_left, cost_usd_per_share], oldest first
+    pnl = defaultdict(float)
+    unmatched = []
+    for t in sorted(trades, key=lambda t: (t.date, t.trade_id)):
+        if t.side == "BUY":
+            cost_per_share = to_usd(t.price * t.qty + t.fee, t.currency) / t.qty
+            lots[t.ticker].append([t.qty, cost_per_share])
+            continue
+        if t.side != "SELL":
+            raise ValueError(f"trade {t.trade_id}: unknown side {t.side!r}")
+
+        # Sells outside the month still consume lots: they shape later cost basis.
+        remaining = t.qty
+        cost = 0.0
+        queue = lots[t.ticker]
+        while remaining and queue:
+            lot = queue[0]
+            take = min(remaining, lot[0])
+            cost += take * lot[1]
+            lot[0] -= take
+            remaining -= take
+            if lot[0] == 0:
+                queue.popleft()
+
+        if (t.date.year, t.date.month) != (year, month):
+            continue
+        if remaining:
+            unmatched.append((t, remaining))
+            continue
+        proceeds = to_usd(t.price * t.qty - t.fee, t.currency)
+        pnl[t.ticker] += proceeds - cost
+    return {ticker: round(v, 2) for ticker, v in sorted(pnl.items())}, unmatched
+
+
+def realized_pnl(trades, year, month):
+    """Realized profit per ticker, in USD, for sells made in the given month.
+
+    Cost basis is FIFO, fees included. A sell without enough earlier buys in
+    ``trades`` is left out; ``unmatched_sales`` lists such sells.
+    """
+    return _match_sales(trades, year, month)[0]
+
+
+def unmatched_sales(trades, year, month):
+    """Sells in the given month that exceed the position held: ``[(trade, missing_qty)]``."""
+    return _match_sales(trades, year, month)[1]
+
+
+def format_report(pnl, unmatched, year, month):
+    lines = [f"Реализованная прибыль за {month:02d}.{year}, USD (FIFO, с комиссиями)"]
+    width = max([len("Итого")] + [len(ticker) for ticker in pnl])
+    for ticker, value in pnl.items():
+        lines.append(f"{ticker:<{width}}  {value:>12,.2f}")
+    if not pnl:
+        lines.append("Закрытых продаж нет.")
+    total = round(sum(pnl.values()), 2)
+    lines.append(f"{'Итого':<{width}}  {total:>12,.2f}")
+    if unmatched:
+        lines.append("")
+        lines.append("Не учтено — продажа без покупки в данных, себестоимость неизвестна:")
+        for t, missing in unmatched:
+            lines.append(
+                f"  {t.ticker}: сделка {t.trade_id} от {t.date.isoformat()}, "
+                f"не хватает {missing} из {t.qty} шт."
+            )
+    return "\n".join(lines)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        prog="python -m app.report",
+        description="Реализованная прибыль за месяц по data/trades.csv, USD.",
+    )
+    parser.add_argument("year", type=int)
+    parser.add_argument("month", type=int)
+    args = parser.parse_args(argv)
+    if not 1 <= args.month <= 12:
+        parser.error("month must be between 1 and 12")
+
+    pnl, unmatched = _match_sales(load_trades(TRADES_CSV), args.year, args.month)
+    print(format_report(pnl, unmatched, args.year, args.month))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_report.py b/tests/test_report.py
new file mode 100644
index 0000000..df392d8
