@@ -15,6 +15,14 @@ class TestPricing(unittest.TestCase):
         with self.assertRaises(ValueError):
             calculate_final_price(10, -1)
 
+    def test_negative_base_price_raises(self):
+        with self.assertRaises(ValueError):
+            calculate_final_price(-10, 3)
