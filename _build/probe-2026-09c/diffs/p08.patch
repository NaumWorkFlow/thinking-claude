diff --git a/app/pricing.py b/app/pricing.py
index 4622104..9acb092 100644
--- a/app/pricing.py
+++ b/app/pricing.py
@@ -3,6 +3,9 @@
 
 def calculate_final_price(base_price, quantity):
     """Calculate the total price for an order line."""
+    # Zero is allowed: free promo SKUs are priced at 0 in app/api.py checkout().
+    if base_price < 0:
+        raise ValueError("base_price must be a non-negative number")
     if quantity <= 0:
         raise ValueError("quantity must be a positive number")
     return base_price * quantity
