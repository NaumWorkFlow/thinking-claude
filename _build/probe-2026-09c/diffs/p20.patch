-"""Portfolio reports."""
+"""Portfolio reports.
+
+Run: python -m app.report YEAR MONTH
+"""
+
+import argparse
+from collections import defaultdict, deque
+from pathlib import Path
+
+from app.fx import to_usd
+from app.trades import load_trades
+
+TRADES_CSV = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def realized_pnl(trades, year, month):
+    """Realized profit in USD per ticker for SELL trades in the given month.
+
+    Cost basis is FIFO over all trades up to the sale, earlier months included.
+    Fees count: a buy fee is added to the lot cost, a sell fee reduces proceeds
+    (the fee is taken to be in the trade's currency). Amounts are converted to
+    USD with app.fx.to_usd.
+
+    If a ticker was ever sold for more shares than had been bought before
+    (a short sale, or buys missing from the export), its cost basis is unknown:
+    its value is None instead of a number.
+    """
+    lots = defaultdict(deque)  # ticker -> [qty left, USD cost per share], oldest first
+    unknown = set()  # tickers with a sale not covered by earlier buys
+    result = {}
+    for t in sorted(trades, key=lambda t: (t.date, t.trade_id)):
+        period = (t.date.year, t.date.month)
+        if period > (year, month):
+            break
+        if t.side == "BUY":
+            cost = to_usd(t.qty * t.price + t.fee, t.currency)
+            lots[t.ticker].append([t.qty, cost / t.qty])
+        elif t.side == "SELL":
+            left = t.qty
+            cost = 0.0
+            queue = lots[t.ticker]
+            while left and queue:
+                take = min(left, queue[0][0])
+                cost += take * queue[0][1]
+                queue[0][0] -= take
+                left -= take
+                if queue[0][0] == 0:
+                    queue.popleft()
+            if left:
+                unknown.add(t.ticker)
+            if period == (year, month):
+                if t.ticker in unknown:
+                    result[t.ticker] = None
+                else:
+                    proceeds = to_usd(t.qty * t.price - t.fee, t.currency)
+                    result[t.ticker] = result.get(t.ticker, 0.0) + proceeds - cost
+        else:
+            raise ValueError(f"trade {t.trade_id}: unknown side {t.side!r}")
+    return result
+
+
+def format_report(pnl, year, month):
+    """Text table of realized_pnl() output with a total line."""
+    lines = [f"Реализованная прибыль за {year}-{month:02d}, USD"]
+    if not pnl:
+        lines.append("Продаж за месяц нет.")
+    for ticker in sorted(pnl):
+        value = pnl[ticker]
+        shown = "н/д" if value is None else f"{value:.2f}"
+        lines.append(f"{ticker:<8}{shown:>12}")
+    known = [v for v in pnl.values() if v is not None]
+    lines.append("-" * 20)
+    lines.append(f"{'Итого':<8}{sum(known):>12.2f}")
+    missing = sorted(k for k, v in pnl.items() if v is None)
+    if missing:
+        lines.append(
+            "н/д: продано больше, чем куплено в выгрузке, себестоимость "
+            "неизвестна. В итог не вошли: " + ", ".join(missing)
+        )
+    return "\n".join(lines)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        prog="python -m app.report",
+        description="Реализованная прибыль за месяц по data/trades.csv",
+    )
+    parser.add_argument("year", type=int)
+    parser.add_argument("month", type=int, choices=range(1, 13), metavar="month")
+    args = parser.parse_args(argv)
+    pnl = realized_pnl(load_trades(TRADES_CSV), args.year, args.month)
+    print(format_report(pnl, args.year, args.month))
+
+
+if __name__ == "__main__":
+    main()
