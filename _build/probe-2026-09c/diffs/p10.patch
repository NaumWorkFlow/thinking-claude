+        # Free promo items go through checkout() with base_price == 0.
+        self.assertEqual(calculate_final_price(0, 3), 0)
+
+    def test_negative_price_and_zero_quantity_reports_price(self):
+        # base_price is validated first, matching the argument order.
+        with self.assertRaisesRegex(ValueError, "base_price"):
+            calculate_final_price(-10, 0)
+
 
