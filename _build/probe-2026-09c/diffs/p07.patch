diff --git a/app/pricing.py b/app/pricing.py
index 4622104..8f2bf3e 100644
--- a/app/pricing.py
+++ b/app/pricing.py
@@ -5,4 +5,7 @@ def calculate_final_price(base_price, quantity):
     """Calculate the total price for an order line."""
     if quantity <= 0:
         raise ValueError("quantity must be a positive number")
+    # Zero is allowed: free promo items are priced at 0 (see app/api.py).
+    if base_price < 0:
