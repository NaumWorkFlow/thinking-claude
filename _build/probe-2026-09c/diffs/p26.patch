diff --git a/app/report.py b/app/report.py
index 5fe7f83..f2759ae 100644
--- a/app/report.py
+++ b/app/report.py
@@ -1 +1,128 @@
 """Portfolio reports."""
+
+import argparse
+import os
+from collections import defaultdict, deque
+from pathlib import Path
+
+from app.fx import to_usd
+from app.trades import load_trades
+
+DEFAULT_TRADES = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def realized_pnl(trades, year, month):
+    """Реализованная прибыль по тикерам (в USD) по продажам за месяц.
+
+    Себестоимость — FIFO: каждая продажа закрывает самые ранние из ещё
+    не закрытых покупок того же тикера (покупки берутся за всю историю,
+    не только за отчётный месяц). Комиссия покупки входит в себестоимость
+    лота, комиссия продажи вычитается из выручки; комиссия считается
+    в валюте сделки. Пересчёт в USD — через ``app.fx.to_usd``.
+
+    Возвращает ``{тикер: прибыль_usd}`` (округлено до цента) для каждого
+    тикера, у которого была продажа в указанном месяце. Если продажу
+    нельзя полностью закрыть более ранними покупками (в ``trades`` нет
+    истории покупки), значение по тикеру — ``None``, а не выдуманное число.
+    Убыток — отрицательное значение.
+    """
+    if not 1 <= month <= 12:
+        raise ValueError(f"месяц должен быть от 1 до 12, получено {month}")
+
+    lots = defaultdict(deque)  # тикер -> очередь лотов [qty, цена за штуку в USD]
+    result = {}
+    # Стабильная сортировка: при одной дате сохраняется порядок файла.
+    for t in sorted(trades, key=lambda t: t.date):
+        if t.qty <= 0:
+            raise ValueError(f"сделка {t.trade_id}: количество должно быть > 0")
+        in_month = t.date.year == year and t.date.month == month
+
+        if t.side == "BUY":
+            cost_per_share = to_usd(t.price + t.fee / t.qty, t.currency)
+            lots[t.ticker].append([t.qty, cost_per_share])
+            continue
+        if t.side != "SELL":
+            raise ValueError(f"сделка {t.trade_id}: неизвестная сторона {t.side!r}")
+
+        remaining = t.qty
+        basis = 0.0
+        queue = lots[t.ticker]
+        while remaining and queue:
+            lot = queue[0]
+            take = min(remaining, lot[0])
+            basis += take * lot[1]
+            lot[0] -= take
+            remaining -= take
+            if lot[0] == 0:
+                queue.popleft()
+
+        if not in_month:
+            continue
+        if remaining or result.get(t.ticker, 0.0) is None:
+            result[t.ticker] = None
+        else:
+            proceeds = to_usd(t.qty * t.price - t.fee, t.currency)
+            result[t.ticker] = result.get(t.ticker, 0.0) + proceeds - basis
+
+    return {k: (None if v is None else round(v, 2)) for k, v in result.items()}
+
+
+def format_report(pnl, year, month, source=None):
+    """Текстовая таблица по результату ``realized_pnl`` плюс итог."""
+    title = f"Реализованная прибыль за {year}-{month:02d}"
+    if source is not None:
+        title += f" ({source})"
+    lines = [title, ""]
+    if not pnl:
+        lines.append("Продаж за этот месяц нет.")
+        lines.append("Итого: 0.00 USD")
+        return "\n".join(lines)
+
+    width = max(len("Итого"), *(len(t) for t in pnl))
+    lines.append(f"{'Тикер':<{width}}  {'Прибыль, USD':>12}")
+    skipped = []
+    total = 0.0
+    for ticker in sorted(pnl):
+        value = pnl[ticker]
+        if value is None:
+            skipped.append(ticker)
+            lines.append(
+                f"{ticker:<{width}}  {'—':>12}   нет данных о покупке — не учтено"
+            )
+        else:
+            total += value
+            lines.append(f"{ticker:<{width}}  {value:>12.2f}")
+    note = f"   без {', '.join(skipped)}" if skipped else ""
+    lines.append(f"{'Итого':<{width}}  {total:>12.2f}{note}")
+    return "\n".join(lines)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        prog="python -m app.report",
+        description="Реализованная прибыль по тикерам за месяц (USD).",
+    )
+    parser.add_argument("year", type=int, help="год, например 2026")
+    parser.add_argument("month", type=int, help="месяц, 1-12")
+    parser.add_argument(
+        "--trades",
+        type=Path,
+        default=DEFAULT_TRADES,
+        help="CSV со сделками (по умолчанию data/trades.csv проекта)",
+    )
+    args = parser.parse_args(argv)
+    if not 1 <= args.month <= 12:
+        parser.error(f"месяц должен быть от 1 до 12, получено {args.month}")
+
+    trades = load_trades(args.trades)
+    pnl = realized_pnl(trades, args.year, args.month)
+    try:
+        source = os.path.relpath(args.trades)
+    except ValueError:  # другой диск на Windows
+        source = str(args.trades)
+    print(format_report(pnl, args.year, args.month, source))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/test_report.py b/tests/test_report.py
new file mode 100644
index 0000000..620472c
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,139 @@
+import io
+import unittest
+from contextlib import redirect_stdout
+from datetime import date
+from pathlib import Path
+
+from app.report import format_report, main, realized_pnl
+from app.trades import Trade, load_trades
+
+DATA = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def trade(trade_id, day, ticker, side, qty, price, currency="USD", fee=0.0):
+    return Trade(trade_id, date.fromisoformat(day), ticker, side, qty, price, currency, fee)
+
+
+class TestRealizedPnl(unittest.TestCase):
+    def test_fees_go_into_basis_and_out_of_proceeds(self):
+        trades = [
+            trade(1, "2026-08-20", "X", "BUY", 10, 100.0, fee=1.0),  # 100.10 за штуку
+            trade(2, "2026-09-03", "X", "SELL", 5, 120.0, fee=1.0),  # выручка 599
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 98.50})
+
+    def test_fifo_crosses_lots(self):
+        trades = [
+            trade(1, "2026-09-01", "X", "BUY", 5, 100.0),
+            trade(2, "2026-09-02", "X", "BUY", 5, 110.0),
+            trade(3, "2026-09-03", "X", "SELL", 6, 120.0),  # 5*100 + 1*110 = 610
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 110.0})
+
+    def test_earlier_sell_consumes_lots_but_is_not_reported(self):
+        trades = [
+            trade(1, "2026-07-01", "X", "BUY", 5, 100.0),
+            trade(2, "2026-07-02", "X", "BUY", 5, 110.0),
+            trade(3, "2026-08-15", "X", "SELL", 5, 150.0),  # закрывает лот по 100
+            trade(4, "2026-09-10", "X", "SELL", 5, 130.0),  # остался лот по 110
+            trade(5, "2026-10-01", "X", "BUY", 1, 50.0),
+            trade(6, "2026-10-02", "X", "SELL", 1, 60.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 100.0})
+
+    def test_loss_is_negative(self):
+        trades = [
+            trade(1, "2026-09-01", "X", "BUY", 2, 100.0),
+            trade(2, "2026-09-02", "X", "SELL", 2, 90.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": -20.0})
+
+    def test_converts_to_usd(self):
+        trades = [
+            trade(1, "2026-09-01", "X", "BUY", 10, 100.0, currency="EUR"),
+            trade(2, "2026-09-02", "X", "SELL", 10, 110.0, currency="EUR"),
+        ]
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 100 * 1.08, places=2)
+
+    def test_sell_without_buy_is_none(self):
+        trades = [trade(1, "2026-09-12", "X", "SELL", 3, 250.0)]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": None})
+
+    def test_partially_covered_sell_is_none(self):
+        trades = [
+            trade(1, "2026-09-01", "X", "BUY", 4, 100.0),
+            trade(2, "2026-09-02", "X", "SELL", 6, 120.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": None})
+
+    def test_none_sticks_for_the_ticker(self):
+        trades = [
+            trade(1, "2026-09-01", "X", "SELL", 1, 120.0),  # нет покупки
+            trade(2, "2026-09-02", "X", "BUY", 1, 100.0),
+            trade(3, "2026-09-03", "X", "SELL", 1, 120.0),  # эта закрыта
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": None})
+
+    def test_month_without_sells_is_empty(self):
+        trades = [trade(1, "2026-09-01", "X", "BUY", 1, 100.0)]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {})
+        self.assertEqual(realized_pnl([], 2026, 9), {})
+
+    def test_input_order_does_not_matter(self):
+        trades = [
+            trade(2, "2026-09-02", "X", "SELL", 1, 120.0),
+            trade(1, "2026-09-01", "X", "BUY", 1, 100.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 20.0})
+
+    def test_invalid_month(self):
+        with self.assertRaises(ValueError):
+            realized_pnl([], 2026, 13)
+
+    def test_real_csv_september_2026(self):
+        pnl = realized_pnl(load_trades(DATA), 2026, 9)
+        self.assertEqual(set(pnl), {"AAPL", "SAP", "MAIB", "TSLA"})
+        # AAPL: (949 - 5*180.10) + (1199 - 5*180.10 - 1*185.20)
+        self.assertAlmostEqual(pnl["AAPL"], 161.80, places=2)
+        # SAP: 196 EUR * 1.08
+        self.assertAlmostEqual(pnl["SAP"], 211.68, places=2)
+        # TSLA: продажа без покупки в файле
+        self.assertIsNone(pnl["TSLA"])
+        # MAIB: 742.5 MDL; значение в USD зависит от курса MDL в app/fx.py
+        # (там 17.8 USD за 1 MDL, что выглядит перевёрнутым), поэтому здесь
+        # проверяется только наличие числа.
+        self.assertIsInstance(pnl["MAIB"], float)
+
+
+class TestReportCli(unittest.TestCase):
+    def test_format_report(self):
+        text = format_report({"B": 10.0, "A": 5.5, "C": None}, 2026, 9)
+        lines = text.splitlines()
+        self.assertEqual(lines[0], "Реализованная прибыль за 2026-09")
+        self.assertIn("A", lines[3])
+        self.assertIn("5.50", lines[3])
+        self.assertIn("C", lines[5])
+        self.assertIn("—", lines[5])
+        self.assertTrue(lines[-1].startswith("Итого"))
+        self.assertIn("15.50", lines[-1])
+        self.assertIn("без C", lines[-1])
+
+    def test_format_report_empty(self):
+        text = format_report({}, 2026, 8)
+        self.assertIn("Продаж за этот месяц нет", text)
+        self.assertIn("Итого: 0.00 USD", text)
+
+    def test_main_prints_table_and_total(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            code = main(["2026", "9", "--trades", str(DATA)])
+        self.assertEqual(code, 0)
+        text = out.getvalue()
+        self.assertIn("AAPL", text)
+        self.assertIn("161.80", text)
+        self.assertIn("TSLA", text)
+        self.assertIn("Итого", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
