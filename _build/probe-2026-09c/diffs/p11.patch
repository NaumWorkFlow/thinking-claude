diff --git a/app/pricing.py b/app/pricing.py
index 4622104..3890e4c 100644
--- a/app/pricing.py
+++ b/app/pricing.py
@@ -3,6 +3,9 @@
 
 def calculate_final_price(base_price, quantity):
     """Calculate the total price for an order line."""
+    # Zero is allowed: checkout() passes base_price=0 for free promo SKUs.
+    if base_price < 0:
+        raise ValueError("base_price must not be negative")
     if quantity <= 0:
         raise ValueError("quantity must be a positive number")
     return base_price * quantity
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
index b49477b..3f11dd8 100644
--- a/tests/test_pricing.py
+++ b/tests/test_pricing.py
@@ -15,6 +15,14 @@ class TestPricing(unittest.TestCase):
         with self.assertRaises(ValueError):
             calculate_final_price(10, -1)
 
+    def test_negative_price_raises(self):
+        with self.assertRaises(ValueError):
+            calculate_final_price(-10, 3)
+
+    def test_zero_price_is_allowed(self):
+        # Free promo SKUs go through checkout() with base_price=0.
+        self.assertEqual(calculate_final_price(0, 3), 0)
+
 
 if __name__ == "__main__":
     unittest.main()
