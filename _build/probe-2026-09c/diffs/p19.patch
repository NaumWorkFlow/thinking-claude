--- a/app/report.py
+++ b/app/report.py
@@ -1 +1,101 @@
 """Portfolio reports."""
+
+import sys
+from collections import defaultdict, deque
+from pathlib import Path
+
+from app.fx import to_usd
+from app.trades import load_trades
+
+DATA = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def realized_pnl(trades, year, month):
+    """Realized profit in USD per ticker for SELL trades in the given month.
+
+    Cost basis is FIFO over all trades up to the end of the month. Fees are
+    included: a BUY fee is added to the lot cost, a SELL fee is subtracted
+    from the proceeds. Amounts are converted with ``app.fx.to_usd``.
+
+    If a ticker sells more shares than the export shows it bought (the buy
+    happened before the export or the position is short), its cost basis is
+    unknown: the ticker's value is ``None`` instead of a made-up number.
+    """
+    lots = defaultdict(deque)  # ticker -> [qty, cost per share] in buy order
+    broken = set()  # tickers whose cost basis is no longer known
+    result = {}
+
+    for t in sorted(trades, key=lambda t: (t.date, t.trade_id)):
+        if (t.date.year, t.date.month) > (year, month):
+            break
+        in_month = (t.date.year, t.date.month) == (year, month)
+
+        if t.side == "BUY":
+            lots[t.ticker].append([t.qty, (t.qty * t.price + t.fee) / t.qty])
+            continue
+        if t.side != "SELL":
+            raise ValueError(f"trade {t.trade_id}: unknown side {t.side!r}")
+
+        queue = lots[t.ticker]
+        if t.ticker in broken or sum(lot[0] for lot in queue) < t.qty:
+            broken.add(t.ticker)
+            queue.clear()
+            if in_month:
+                result[t.ticker] = None
+            continue
+
+        cost = 0.0
+        left = t.qty
+        while left:
+            lot = queue[0]
+            take = min(left, lot[0])
+            cost += take * lot[1]
+            lot[0] -= take
+            left -= take
+            if lot[0] == 0:
+                queue.popleft()
+
+        if in_month:
+            pnl = to_usd(t.qty * t.price - t.fee - cost, t.currency)
+            result[t.ticker] = result.get(t.ticker, 0.0) + pnl
+
+    return result
+
+
+def format_report(pnl, year, month):
+    """Render the realized P&L dict as a text table with a total."""
+    lines = [f"Реализованная прибыль за {year}-{month:02d}, USD", ""]
+    lines.append(f"{'Тикер':<8}{'USD':>12}")
+    lines.append("-" * 20)
+    for ticker in sorted(pnl):
+        value = pnl[ticker]
+        cell = "н/д" if value is None else f"{value:.2f}"
+        lines.append(f"{ticker:<8}{cell:>12}")
+    lines.append("-" * 20)
+    known = [v for v in pnl.values() if v is not None]
+    lines.append(f"{'Итого':<8}{sum(known):>12.2f}")
+    unknown = sorted(k for k, v in pnl.items() if v is None)
+    if unknown:
+        lines.append("")
+        lines.append(
+            "н/д: продано больше, чем куплено по выгрузке, — себестоимость "
+            f"неизвестна, в итог не вошло: {', '.join(unknown)}"
+        )
+    return "\n".join(lines)
+
+
+def main(argv=None):
+    argv = sys.argv[1:] if argv is None else argv
+    if len(argv) != 2:
+        print("usage: python -m app.report YEAR MONTH", file=sys.stderr)
+        return 2
+    year, month = int(argv[0]), int(argv[1])
+    if not 1 <= month <= 12:
+        print(f"month must be 1..12, got {month}", file=sys.stderr)
+        return 2
+    print(format_report(realized_pnl(load_trades(DATA), year, month), year, month))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
