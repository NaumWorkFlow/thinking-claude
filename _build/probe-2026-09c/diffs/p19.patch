diff --git a/tests/test_report.py b/tests/test_report.py
new file mode 100644
index 0000000..623bdc7
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,116 @@
+import io
+import unittest
+from contextlib import redirect_stdout
+from datetime import date
+from pathlib import Path
+
+from app.report import main, realized_pnl
+from app.trades import Trade, load_trades
+
+DATA = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+_next_id = iter(range(1, 10_000))
+
+
+def trade(day, ticker, side, qty, price, currency="USD", fee=0.0):
+    return Trade(next(_next_id), date.fromisoformat(day), ticker, side, qty,
+                 price, currency, fee)
+
+
+class TestRealizedPnl(unittest.TestCase):
+    def test_simple_round_trip_with_fees(self):
+        trades = [
+            trade("2026-09-01", "X", "BUY", 10, 100.0, fee=2.0),
+            trade("2026-09-10", "X", "SELL", 10, 110.0, fee=3.0),
+        ]
+        # 1100 - 3 - (1000 + 2)
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 95.0)
+
+    def test_fifo_takes_oldest_lot_first(self):
+        trades = [
+            trade("2026-08-01", "X", "BUY", 5, 100.0),
+            trade("2026-08-02", "X", "BUY", 5, 200.0),
+            trade("2026-09-01", "X", "SELL", 6, 300.0),
+        ]
+        # cost = 5*100 + 1*200 = 700, proceeds 1800
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 1100.0)
+
+    def test_only_sells_in_requested_month(self):
+        trades = [
+            trade("2026-08-01", "X", "BUY", 10, 100.0),
+            trade("2026-08-15", "X", "SELL", 4, 150.0),
+            trade("2026-09-15", "X", "SELL", 2, 120.0),
+            trade("2026-10-01", "X", "SELL", 4, 500.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 40.0})
+
+    def test_buy_after_month_does_not_count(self):
+        trades = [
+            trade("2026-09-01", "X", "SELL", 1, 100.0),
+            trade("2026-10-01", "X", "BUY", 1, 10.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": None})
+
+    def test_sell_without_known_buy_is_none(self):
+        trades = [
+            trade("2026-09-01", "X", "BUY", 2, 100.0),
+            trade("2026-09-02", "X", "SELL", 3, 100.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": None})
+
+    def test_unknown_basis_stays_unknown(self):
+        trades = [
+            trade("2026-08-01", "X", "SELL", 1, 100.0),
+            trade("2026-08-02", "X", "BUY", 1, 100.0),
+            trade("2026-09-01", "X", "SELL", 1, 100.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": None})
+
+    def test_converts_to_usd(self):
+        trades = [
+            trade("2026-09-01", "E", "BUY", 1, 100.0, "EUR"),
+            trade("2026-09-02", "E", "SELL", 1, 200.0, "EUR"),
+            trade("2026-09-01", "M", "BUY", 1, 100.0, "MDL"),
+            trade("2026-09-02", "M", "SELL", 1, 278.0, "MDL"),
+        ]
+        pnl = realized_pnl(trades, 2026, 9)
+        self.assertAlmostEqual(pnl["E"], 108.0)
+        self.assertAlmostEqual(pnl["M"], 10.0)  # 178 MDL at 17.8 MDL/USD
+
+    def test_orders_by_date_not_file_order(self):
+        trades = [
+            trade("2026-09-02", "X", "SELL", 1, 150.0),
+            trade("2026-09-01", "X", "BUY", 1, 100.0),
+        ]
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 50.0)
+
+    def test_empty_month(self):
+        self.assertEqual(realized_pnl(load_trades(DATA), 2026, 7), {})
+
+
+class TestRealizedPnlOnData(unittest.TestCase):
+    def test_september_2026(self):
+        pnl = realized_pnl(load_trades(DATA), 2026, 9)
+        self.assertEqual(set(pnl), {"AAPL", "SAP", "MAIB", "TSLA"})
+        # AAPL: (950-1 - 5*180.1) + (1200-1 - 5*180.1 - 185.2)
+        self.assertAlmostEqual(pnl["AAPL"], 161.8)
+        # SAP: (3200-2 - 3002) EUR * 1.08
+        self.assertAlmostEqual(pnl["SAP"], 211.68)
+        # MAIB: (5500-5 - 50*95.05) MDL / 17.8
+        self.assertAlmostEqual(pnl["MAIB"], 742.5 / 17.8)
+        # TSLA: sold 3, no buy in the export
+        self.assertIsNone(pnl["TSLA"])
+
+    def test_cli_prints_table_and_total(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            code = main(["2026", "9"])
+        self.assertEqual(code, 0)
+        text = out.getvalue()
+        self.assertIn("AAPL", text)
+        self.assertIn("н/д", text)
+        self.assertIn(f"{161.8 + 211.68 + 742.5 / 17.8:.2f}", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
