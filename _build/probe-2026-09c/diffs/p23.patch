diff --git a/tests/test_report.py b/tests/test_report.py
new file mode 100644
index 0000000..7b789fc
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,141 @@
+import io
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from datetime import date
+from pathlib import Path
+
+from app.report import format_report, main, realized_pnl
+from app.trades import Trade, load_trades
+
+DATA = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def trade(trade_id, day, ticker, side, qty, price, currency="USD", fee=0.0):
+    return Trade(trade_id, date.fromisoformat(day), ticker, side, qty, price, currency, fee)
+
+
+class TestRealizedPnl(unittest.TestCase):
+    def test_simple_sale_with_fees(self):
+        # Cost basis includes the purchase fee, proceeds exclude the sale fee.
+        trades = [
+            trade(1, "2026-09-01", "X", "BUY", 10, 100.0, fee=1.0),
+            trade(2, "2026-09-10", "X", "SELL", 10, 110.0, fee=2.0),
+        ]
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 1100 - 2 - (1000 + 1))
+
+    def test_fifo_across_months_and_partial_lots(self):
+        # Buy before the month is the cost basis; the second sale straddles two lots.
+        trades = [
+            trade(1, "2026-08-20", "X", "BUY", 10, 180.0, fee=1.0),   # 180.1 / share
+            trade(2, "2026-09-03", "X", "SELL", 5, 190.0, fee=1.0),   # 949 - 900.5 = 48.5
+            trade(3, "2026-09-15", "X", "BUY", 5, 185.0, fee=1.0),    # 185.2 / share
+            trade(4, "2026-09-25", "X", "SELL", 6, 200.0, fee=1.0),   # 1199 - (900.5 + 185.2) = 113.3
+        ]
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 48.5 + 113.3)
+
+    def test_fifo_takes_oldest_lot_first(self):
+        trades = [
+            trade(1, "2026-09-01", "X", "BUY", 1, 100.0),
+            trade(2, "2026-09-02", "X", "BUY", 1, 200.0),
+            trade(3, "2026-09-03", "X", "SELL", 1, 150.0),
+        ]
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 50.0)
+
+    def test_converts_to_usd(self):
+        trades = [
+            trade(1, "2026-09-05", "S", "BUY", 20, 150.0, "EUR", 2.0),
+            trade(2, "2026-09-18", "S", "SELL", 20, 160.0, "EUR", 2.0),
+        ]
+        # (3198 - 3002) EUR * 1.08
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["S"], 196 * 1.08)
+
+    def test_only_sales_inside_month_are_reported(self):
+        trades = [
+            trade(1, "2026-08-01", "X", "BUY", 3, 100.0),
+            trade(2, "2026-08-15", "X", "SELL", 1, 120.0),  # August: consumes a lot, not reported
+            trade(3, "2026-09-10", "X", "SELL", 1, 130.0),
+            trade(4, "2026-10-01", "X", "SELL", 1, 999.0),  # October: ignored
+            trade(5, "2026-10-02", "Y", "SELL", 1, 999.0),  # no sales of Y in September
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 30.0})
+
+    def test_no_sales_in_month(self):
+        trades = [trade(1, "2026-09-01", "X", "BUY", 1, 100.0)]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {})
+        self.assertEqual(realized_pnl([], 2026, 9), {})
+
+    def test_sale_without_lots_is_none(self):
+        # Selling shares that were never bought in the export: no cost basis.
+        trades = [
+            trade(1, "2026-09-12", "T", "SELL", 3, 250.0, fee=1.0),
+            trade(2, "2026-09-01", "X", "BUY", 1, 100.0),
+            trade(3, "2026-09-02", "X", "SELL", 1, 110.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"T": None, "X": 10.0})
+
+    def test_oversold_ticker_stays_none_for_whole_month(self):
+        # Once a sale can't be matched, a later matched sale must not "revive" a number.
+        trades = [
+            trade(1, "2026-09-01", "T", "BUY", 1, 100.0),
+            trade(2, "2026-09-02", "T", "SELL", 2, 110.0),  # 1 share unmatched
+            trade(3, "2026-09-03", "T", "BUY", 1, 100.0),
+            trade(4, "2026-09-04", "T", "SELL", 1, 110.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"T": None})
+
+    def test_input_order_does_not_matter(self):
+        trades = [
+            trade(1, "2026-08-20", "X", "BUY", 10, 180.0, fee=1.0),
+            trade(2, "2026-09-03", "X", "SELL", 5, 190.0, fee=1.0),
+            trade(3, "2026-09-15", "X", "BUY", 5, 185.0, fee=1.0),
+            trade(4, "2026-09-25", "X", "SELL", 6, 200.0, fee=1.0),
+        ]
+        expected = realized_pnl(trades, 2026, 9)
+        self.assertEqual(realized_pnl(list(reversed(trades)), 2026, 9), expected)
+
+    def test_rejects_bad_input(self):
+        with self.assertRaises(ValueError):
+            realized_pnl([trade(1, "2026-09-01", "X", "SHORT", 1, 1.0)], 2026, 9)
+        with self.assertRaises(ValueError):
+            realized_pnl([trade(1, "2026-09-01", "X", "BUY", 0, 1.0)], 2026, 9)
+        with self.assertRaises(ValueError):
+            realized_pnl([], 2026, 13)
+
+    def test_real_data_september_2026(self):
+        pnl = realized_pnl(load_trades(DATA), 2026, 9)
+        self.assertEqual(set(pnl), {"AAPL", "SAP", "MAIB", "TSLA"})
+        self.assertAlmostEqual(pnl["AAPL"], 161.8)
+        self.assertAlmostEqual(pnl["SAP"], 211.68)
+        self.assertAlmostEqual(pnl["MAIB"], 742.5 / 17.8)  # 41.71
+        self.assertIsNone(pnl["TSLA"])
+
+
+class TestCli(unittest.TestCase):
+    def test_format_report_total_excludes_unknown(self):
+        text = format_report({"B": 2.5, "A": 1.0, "T": None}, 2026, 9)
+        lines = text.splitlines()
+        self.assertIn("2026-09", lines[0])
+        self.assertTrue(lines[2].startswith("A"))  # sorted by ticker
+        self.assertIn("н/д", text)
+        self.assertRegex(text, r"Итого\s+3\.50")
+        self.assertIn("T", lines[-1])
+
+    def test_main_prints_table_for_september(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            main(["2026", "9", "--trades", str(DATA)])
+        text = out.getvalue()
+        self.assertRegex(text, r"AAPL\s+161\.80")
+        self.assertRegex(text, r"MAIB\s+41\.71")
+        self.assertRegex(text, r"SAP\s+211\.68")
+        self.assertRegex(text, r"TSLA\s+н/д")
+        self.assertRegex(text, r"Итого\s+415\.19")
+
+    def test_main_rejects_bad_month(self):
+        with self.assertRaises(SystemExit):
+            with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+                main(["2026", "13"])
+
+
+if __name__ == "__main__":
+    unittest.main()
