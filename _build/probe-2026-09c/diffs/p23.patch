@@ -1 +1,113 @@
 """Portfolio reports."""
+
+import argparse
+from collections import defaultdict, deque
+from datetime import date
+from pathlib import Path
+
+from app.fx import to_usd
+from app.trades import load_trades
+
+PROJECT_ROOT = Path(__file__).resolve().parent.parent
+DEFAULT_TRADES = PROJECT_ROOT / "data" / "trades.csv"
+
+
+def realized_pnl(trades, year, month):
+    """Realized profit per ticker, in USD, for sales made in the given month.
+
+    Lots are matched FIFO over the whole trade history (chronologically by
+    date, then trade_id), so purchases made before the month serve as cost
+    basis for sales inside it. Fees are included: a purchase fee is spread
+    over the lot's shares, a sale fee is deducted from the proceeds. Amounts
+    are converted to USD with ``app.fx.to_usd``.
+
+    Returns ``{ticker: pnl_usd}`` with one entry per ticker that had at least
+    one sale in the month. If a sale of a ticker in that month exceeds the
+    shares bought before it (history missing from the export, or a short
+    sale), the profit cannot be determined and the ticker maps to ``None``.
+    """
+    if not 1 <= month <= 12:
+        raise ValueError(f"month must be 1..12, got {month!r}")
+    next_month = date(year + (month == 12), month % 12 + 1, 1)
+
+    lots = defaultdict(deque)  # ticker -> deque of [qty_left, cost_usd_per_share]
+    result = {}
+    for t in sorted(trades, key=lambda t: (t.date, t.trade_id)):
+        if t.date >= next_month:
+            break  # later trades cannot affect sales in the target month
+        if t.qty <= 0:
+            raise ValueError(f"trade {t.trade_id}: qty must be positive, got {t.qty!r}")
+
+        if t.side == "BUY":
+            cost_usd = to_usd(t.price * t.qty + t.fee, t.currency)
+            lots[t.ticker].append([t.qty, cost_usd / t.qty])
+            continue
+        if t.side != "SELL":
+            raise ValueError(f"trade {t.trade_id}: unknown side {t.side!r}")
+
+        remaining = t.qty
+        cost_usd = 0.0
+        queue = lots[t.ticker]
+        while remaining and queue:
+            lot = queue[0]
+            take = min(lot[0], remaining)
+            cost_usd += take * lot[1]
+            lot[0] -= take
+            remaining -= take
+            if lot[0] == 0:
+                queue.popleft()
+
+        if t.date.year != year or t.date.month != month:
+            continue  # earlier sale: only consumes lots, not reported
+        if remaining:
+            result[t.ticker] = None
+        elif result.get(t.ticker, 0.0) is not None:
+            proceeds_usd = to_usd(t.price * t.qty - t.fee, t.currency)
+            result[t.ticker] = result.get(t.ticker, 0.0) + proceeds_usd - cost_usd
+    return result
+
+
+def format_report(pnl, year, month):
+    """Render the ``realized_pnl`` result as a text table with a total."""
+    lines = [f"Реализованная прибыль за {year}-{month:02d} (FIFO, USD)"]
+    lines.append(f"{'Тикер':<8}{'PnL, USD':>14}")
+    total = 0.0
+    unknown = []
+    for ticker in sorted(pnl):
+        value = pnl[ticker]
+        if value is None:
+            unknown.append(ticker)
+            lines.append(f"{ticker:<8}{'н/д':>14}")
+        else:
+            total += value
+            lines.append(f"{ticker:<8}{value:>14.2f}")
+    lines.append("-" * 22)
+    lines.append(f"{'Итого':<8}{total:>14.2f}")
+    if unknown:
+        lines.append(
+            "н/д: продажа без открытых лотов в выгрузке (покупок раньше нет), "
+            f"прибыль не рассчитана и в итог не входит — {', '.join(unknown)}"
+        )
+    return "\n".join(lines)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        prog="python -m app.report",
+        description="Реализованная прибыль по тикерам за месяц (USD).",
+    )
+    parser.add_argument("year", type=int)
+    parser.add_argument("month", type=int, choices=range(1, 13), metavar="month")
+    parser.add_argument(
+        "--trades",
+        type=Path,
+        default=DEFAULT_TRADES,
+        help="CSV со сделками (по умолчанию data/trades.csv проекта)",
+    )
+    args = parser.parse_args(argv)
+    pnl = realized_pnl(load_trades(args.trades), args.year, args.month)
+    print(format_report(pnl, args.year, args.month))
+
+
+if __name__ == "__main__":
+    main()
