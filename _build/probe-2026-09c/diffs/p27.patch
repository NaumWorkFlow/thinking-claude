@@ -0,0 +1,202 @@
+import contextlib
+import io
+import subprocess
+import sys
+import tempfile
+import unittest
+import warnings
+from datetime import date
+from pathlib import Path
+
+from app.fx import to_usd
+from app.report import UnmatchedSellWarning, main, realized_pnl
+from app.trades import Trade, load_trades
+
+ROOT = Path(__file__).resolve().parent.parent
+DATA = ROOT / "data" / "trades.csv"
+
+
+def _t(trade_id, day, ticker, side, qty, price, currency="USD", fee=0.0):
+    return Trade(
+        trade_id=trade_id,
+        date=date.fromisoformat(day),
+        ticker=ticker,
+        side=side,
+        qty=qty,
+        price=price,
+        currency=currency,
+        fee=fee,
+    )
+
+
+class TestRealizedPnl(unittest.TestCase):
+    def test_simple_round_trip_includes_fees(self):
+        trades = [
+            _t(1, "2026-09-01", "X", "BUY", 10, 100.0, fee=1.0),
+            _t(2, "2026-09-10", "X", "SELL", 10, 110.0, fee=1.0),
+        ]
+        # 1100 - 1 (sell fee) - 1000 - 1 (buy fee)
+        result = realized_pnl(trades, 2026, 9)
+        self.assertEqual(list(result), ["X"])
+        self.assertAlmostEqual(result["X"], 98.0)
+
+    def test_fifo_across_months_and_lots(self):
+        trades = [
+            _t(1, "2026-08-20", "AAPL", "BUY", 10, 180.0, fee=1.0),
+            _t(2, "2026-09-03", "AAPL", "SELL", 5, 190.0, fee=1.0),
+            _t(3, "2026-09-15", "AAPL", "BUY", 5, 185.0, fee=1.0),
+            _t(4, "2026-09-25", "AAPL", "SELL", 6, 200.0, fee=1.0),
+        ]
+        # sell 5: 949 - 5*180.10 = 48.50
+        # sell 6: 1199 - (5*180.10 + 1*185.20) = 113.30
+        result = realized_pnl(trades, 2026, 9)
+        self.assertEqual(list(result), ["AAPL"])
+        self.assertAlmostEqual(result["AAPL"], 161.80)
+
+    def test_only_sells_in_target_month_count_but_all_trades_consume_lots(self):
+        trades = [
+            _t(1, "2026-07-01", "X", "BUY", 10, 100.0),
+            _t(2, "2026-08-01", "X", "SELL", 10, 150.0),  # uses up the cheap lot
+            _t(3, "2026-08-15", "X", "BUY", 10, 120.0),
+            _t(4, "2026-09-05", "X", "SELL", 10, 130.0),
+            _t(5, "2026-10-01", "X", "BUY", 10, 50.0),
+            _t(6, "2026-10-02", "X", "SELL", 10, 60.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 100.0})
+        self.assertEqual(realized_pnl(trades, 2026, 8), {"X": 500.0})
+        self.assertEqual(realized_pnl(trades, 2026, 10), {"X": 100.0})
+
+    def test_converts_to_usd(self):
+        trades = [
+            _t(1, "2026-09-05", "SAP", "BUY", 20, 150.0, "EUR", fee=2.0),
+            _t(2, "2026-09-18", "SAP", "SELL", 20, 160.0, "EUR", fee=2.0),
+        ]
+        # (3200 - 2) - (3000 + 2) = 196 EUR
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["SAP"], to_usd(196.0, "EUR"))
+
+    def test_input_order_does_not_matter(self):
+        trades = [
+            _t(4, "2026-09-25", "AAPL", "SELL", 6, 200.0, fee=1.0),
+            _t(1, "2026-08-20", "AAPL", "BUY", 10, 180.0, fee=1.0),
+            _t(3, "2026-09-15", "AAPL", "BUY", 5, 185.0, fee=1.0),
+            _t(2, "2026-09-03", "AAPL", "SELL", 5, 190.0, fee=1.0),
+        ]
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["AAPL"], 161.80)
+
+    def test_same_day_trades_ordered_by_trade_id(self):
+        trades = [
+            _t(2, "2026-09-01", "X", "SELL", 10, 110.0),
+            _t(1, "2026-09-01", "X", "BUY", 10, 100.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 100.0})
+
+    def test_sell_without_buy_is_skipped_with_warning(self):
+        trades = [_t(1, "2026-09-12", "TSLA", "SELL", 3, 250.0, fee=1.0)]
+        with self.assertWarns(UnmatchedSellWarning) as cm:
+            result = realized_pnl(trades, 2026, 9)
+        self.assertEqual(result, {})
+        self.assertIn("TSLA", str(cm.warning))
+        self.assertIn("trade 1", str(cm.warning))
+
+    def test_partially_matched_sell_counts_matched_part_only(self):
+        trades = [
+            _t(1, "2026-09-01", "X", "BUY", 2, 100.0),
+            _t(2, "2026-09-02", "X", "SELL", 3, 110.0, fee=3.0),
+        ]
+        with self.assertWarns(UnmatchedSellWarning) as cm:
+            result = realized_pnl(trades, 2026, 9)
+        # 2 shares matched: 2 * (110 - 1 fee/share - 100) = 18
+        self.assertAlmostEqual(result["X"], 18.0)
+        self.assertIn("1 of them", str(cm.warning))
+
+    def test_unmatched_sell_outside_target_month_does_not_warn(self):
+        trades = [
+            _t(1, "2026-08-12", "TSLA", "SELL", 3, 250.0),
+            _t(2, "2026-09-01", "X", "BUY", 1, 10.0),
+            _t(3, "2026-09-02", "X", "SELL", 1, 12.0),
+        ]
+        with warnings.catch_warnings():
+            warnings.simplefilter("error")
+            self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 2.0})
+
+    def test_result_sorted_by_ticker(self):
+        trades = [
+            _t(1, "2026-09-01", "ZZZ", "BUY", 1, 1.0),
+            _t(2, "2026-09-01", "AAA", "BUY", 1, 1.0),
+            _t(3, "2026-09-02", "ZZZ", "SELL", 1, 2.0),
+            _t(4, "2026-09-02", "AAA", "SELL", 1, 2.0),
+        ]
+        self.assertEqual(list(realized_pnl(trades, 2026, 9)), ["AAA", "ZZZ"])
+
+    def test_no_trades_or_no_sells_gives_empty_dict(self):
+        self.assertEqual(realized_pnl([], 2026, 9), {})
+        self.assertEqual(realized_pnl([_t(1, "2026-09-01", "X", "BUY", 1, 1.0)], 2026, 9), {})
+
+    def test_invalid_month_and_side_and_qty(self):
+        with self.assertRaises(ValueError):
+            realized_pnl([], 2026, 13)
+        with self.assertRaises(ValueError):
+            realized_pnl([_t(1, "2026-09-01", "X", "SHORT", 1, 1.0)], 2026, 9)
+        with self.assertRaises(ValueError):
+            realized_pnl([_t(1, "2026-09-01", "X", "BUY", 0, 1.0)], 2026, 9)
+
+    def test_real_data_september_2026(self):
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always", UnmatchedSellWarning)
+            result = realized_pnl(load_trades(DATA), 2026, 9)
+        self.assertEqual(list(result), ["AAPL", "MAIB", "SAP"])
+        self.assertAlmostEqual(result["AAPL"], 161.80)
+        self.assertAlmostEqual(result["SAP"], to_usd(196.0, "EUR"))
+        # (5500 - 5) - 50 * (95 + 5/100) = 742.5 MDL; the rate comes from app.fx
+        self.assertAlmostEqual(result["MAIB"], to_usd(742.5, "MDL"))
+        self.assertEqual(len(caught), 1)
+        self.assertIn("TSLA", str(caught[0].message))
+
+
+class TestCli(unittest.TestCase):
+    def _run(self, argv):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            code = main(argv)
+        return code, out.getvalue()
+
+    def test_prints_table_total_and_unmatched_note(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            csv_path = Path(tmp) / "trades.csv"
+            csv_path.write_text(
+                "trade_id,date,ticker,side,qty,price,currency,fee\n"
+                "1,2026-09-01,X,BUY,10,100.00,USD,1.00\n"
+                "2,2026-09-10,X,SELL,10,110.00,USD,1.00\n"
+                "3,2026-09-11,Y,SELL,1,50.00,USD,0.00\n",
+                encoding="utf-8",
+            )
+            code, out = self._run(["2026", "9", "--trades", str(csv_path)])
+        self.assertEqual(code, 0)
+        lines = out.splitlines()
+        self.assertIn("2026-09", lines[0])
+        self.assertTrue(any(line.startswith("X") and line.endswith("98.00") for line in lines))
+        self.assertTrue(any(line.startswith("Итого") and line.endswith("98.00") for line in lines))
+        self.assertTrue(any("Не учтено" in line and "Y" in line for line in lines))
+        self.assertFalse(any(line.startswith("Y ") for line in lines))
+
+    def test_month_without_sells(self):
+        code, out = self._run(["2026", "1", "--trades", str(DATA)])
+        self.assertEqual(code, 0)
+        self.assertIn("продаж за месяц нет", out)
+
+    def test_module_entry_point_on_real_data(self):
+        proc = subprocess.run(
+            [sys.executable, "-m", "app.report", "2026", "9"],
+            cwd=ROOT,
+            capture_output=True,
+            text=True,
+            check=True,
+        )
+        self.assertIn("AAPL", proc.stdout)
+        self.assertIn("161.80", proc.stdout)
+        self.assertIn("Итого", proc.stdout)
+        self.assertIn("TSLA", proc.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
