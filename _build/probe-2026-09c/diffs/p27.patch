 """Portfolio reports."""
+
+import argparse
+import sys
+import warnings
+from collections import defaultdict, deque
+from pathlib import Path
+
+from app.fx import to_usd
+from app.trades import load_trades
+
+DEFAULT_TRADES = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+class UnmatchedSellWarning(UserWarning):
+    """A SELL (or part of it) has no BUY lots to match: cost basis is unknown."""
+
+
+def realized_pnl(trades, year, month):
+    """Realized profit in USD per ticker for SELL trades in the given month.
+
+    Lots are matched FIFO over the whole trade history, so buys and sells
+    from earlier months are taken into account. Fees are included: the buy
+    fee is spread over the lot's shares, the sell fee over the sold shares.
+    Every amount is converted to USD with ``app.fx.to_usd``.
+
+    A SELL that has no BUY lots left (position opened outside the export)
+    cannot be priced: that quantity is skipped and an ``UnmatchedSellWarning``
+    is emitted. Tickers without matched sells in the month are absent from
+    the result. The result is ordered by ticker.
+    """
+    if not 1 <= month <= 12:
+        raise ValueError(f"month must be in 1..12, got {month}")
+
+    lots = defaultdict(deque)  # ticker -> deque of [qty_left, cost_per_share_usd]
+    pnl = defaultdict(float)
+
+    for t in sorted(trades, key=lambda t: (t.date, t.trade_id)):
+        if t.qty <= 0:
+            raise ValueError(f"trade {t.trade_id}: qty must be positive, got {t.qty}")
+
+        if t.side == "BUY":
+            cost_per_share = to_usd(t.price + t.fee / t.qty, t.currency)
+            lots[t.ticker].append([t.qty, cost_per_share])
+
+        elif t.side == "SELL":
+            in_month = (t.date.year, t.date.month) == (year, month)
+            proceeds_per_share = to_usd(t.price - t.fee / t.qty, t.currency)
+            remaining = t.qty
+            queue = lots[t.ticker]
+            while remaining and queue:
+                lot = queue[0]
+                n = min(remaining, lot[0])
+                if in_month:
+                    pnl[t.ticker] += n * (proceeds_per_share - lot[1])
+                lot[0] -= n
+                remaining -= n
+                if lot[0] == 0:
+                    queue.popleft()
+            if remaining and in_month:
+                warnings.warn(
+                    f"{t.ticker}: SELL {t.qty} on {t.date} (trade {t.trade_id}) - "
+                    f"{remaining} of them have no BUY in the data, skipped",
+                    UnmatchedSellWarning,
+                    stacklevel=2,
+                )
+
+        else:
+            raise ValueError(f"trade {t.trade_id}: unknown side {t.side!r}")
+
+    return {ticker: pnl[ticker] for ticker in sorted(pnl)}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        prog="python -m app.report",
+        description="Реализованная прибыль за месяц по тикерам, USD (FIFO, с учётом комиссий).",
+    )
+    parser.add_argument("year", type=int, help="год, например 2026")
+    parser.add_argument("month", type=int, choices=range(1, 13), metavar="month", help="месяц 1..12")
+    parser.add_argument(
+        "--trades", type=Path, default=DEFAULT_TRADES, help=f"CSV со сделками (по умолчанию {DEFAULT_TRADES})"
+    )
+    args = parser.parse_args(argv)
+
+    trades = load_trades(args.trades)
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always", UnmatchedSellWarning)
+        result = realized_pnl(trades, args.year, args.month)
+
+    print(f"Реализованная прибыль за {args.year}-{args.month:02d}, USD (FIFO, с учётом комиссий)")
+    if result:
+        width = max(len("Тикер"), *(len(t) for t in result))
+        print(f"{'Тикер':<{width}}  {'PnL':>12}")
+        for ticker, value in result.items():
+            print(f"{ticker:<{width}}  {value:>12.2f}")
+        print("-" * (width + 14))
+        print(f"{'Итого':<{width}}  {sum(result.values()):>12.2f}")
+    else:
+        print("Учтённых продаж за месяц нет.")
+    for w in caught:
+        print(f"Не учтено: {w.message}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/test_report.py b/tests/test_report.py
