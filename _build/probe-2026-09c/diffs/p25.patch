diff --git a/app/report.py b/app/report.py
index 5fe7f83..ac17084 100644
--- a/app/report.py
+++ b/app/report.py
@@ -1 +1,127 @@
 """Portfolio reports."""
+
+import argparse
+import sys
+from collections import defaultdict, deque
+from pathlib import Path
+
+from app.fx import to_usd
+from app.trades import load_trades
+
+DEFAULT_TRADES = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def realized_pnl(trades, year, month):
+    """Realized profit per ticker, in USD, for SELL trades dated in the month.
+
+    Lots are matched FIFO in chronological order over the whole trade
+    history, so purchases from earlier months form the cost basis and sales
+    from earlier months consume it.  Fees are included: a purchase fee is
+    spread over the units of the lot, a sale fee is deducted from proceeds.
+    Every amount is converted to USD with :func:`app.fx.to_usd`.
+
+    If a SELL in the month cannot be fully matched against purchases on
+    record (for example the position was opened before the export starts),
+    its cost basis is unknown and the ticker maps to ``None`` instead of a
+    number -- it is never reported as a profit on a zero basis.
+
+    Returns ``{ticker: pnl_usd}`` for tickers sold in the month; ``pnl_usd``
+    is ``None`` when it cannot be computed.
+    """
+    lots = defaultdict(deque)  # ticker -> deque of [qty_left, unit_cost_usd]
+    pnl = {}
+
+    for t in sorted(trades, key=lambda t: (t.date, t.trade_id)):
+        if t.qty <= 0:
+            raise ValueError(f"trade {t.trade_id}: qty must be positive, got {t.qty}")
+
+        if t.side == "BUY":
+            unit_cost = to_usd(t.price + t.fee / t.qty, t.currency)
+            lots[t.ticker].append([t.qty, unit_cost])
+            continue
+
+        if t.side != "SELL":
+            raise ValueError(f"trade {t.trade_id}: unknown side {t.side!r}")
+
+        # Consume lots FIFO regardless of the month: earlier sales shape
+        # what is left for the month being reported.
+        queue = lots[t.ticker]
+        remaining = t.qty
+        cost = 0.0
+        while remaining and queue:
+            lot = queue[0]
+            take = min(remaining, lot[0])
+            cost += take * lot[1]
+            lot[0] -= take
+            remaining -= take
+            if lot[0] == 0:
+                queue.popleft()
+
+        if not (t.date.year == year and t.date.month == month):
+            continue
+
+        if remaining or pnl.get(t.ticker, 0.0) is None:
+            pnl[t.ticker] = None
+        else:
+            proceeds = to_usd(t.qty * t.price - t.fee, t.currency)
+            pnl[t.ticker] = pnl.get(t.ticker, 0.0) + proceeds - cost
+
+    return pnl
+
+
+def format_report(pnl, year, month):
+    """Render the result of :func:`realized_pnl` as a plain-text table."""
+    title = f"Реализованная прибыль за {year}-{month:02d}, USD"
+    if not pnl:
+        return f"{title}\n\nПродаж за этот месяц нет."
+
+    width = max(len("Итого*"), *(len(ticker) for ticker in pnl))
+    lines = [title, ""]
+    for ticker in sorted(pnl):
+        value = pnl[ticker]
+        cell = "n/a" if value is None else f"{value:,.2f}"
+        lines.append(f"{ticker:<{width}}  {cell:>12}")
+
+    known = [v for v in pnl.values() if v is not None]
+    unknown = sorted(t for t, v in pnl.items() if v is None)
+    lines.append("-" * (width + 14))
+    label = "Итого" if not unknown else "Итого*"
+    lines.append(f"{label:<{width}}  {sum(known):>12,.2f}")
+    if unknown:
+        lines.append("")
+        lines.append(
+            "* без " + ", ".join(unknown) + ": продажа есть, а покупки в выгрузке нет — "
+            "база стоимости неизвестна, прибыль не посчитать."
+        )
+    return "\n".join(lines)
+
+
+def _month(value):
+    month = int(value)
+    if not 1 <= month <= 12:
+        raise argparse.ArgumentTypeError(f"month must be 1..12, got {value}")
+    return month
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        prog="python -m app.report",
+        description="Реализованная прибыль по тикерам за месяц, в USD.",
+    )
+    parser.add_argument("year", type=int)
+    parser.add_argument("month", type=_month)
+    parser.add_argument(
+        "--trades",
+        type=Path,
+        default=DEFAULT_TRADES,
+        help=f"CSV со сделками (по умолчанию {DEFAULT_TRADES})",
+    )
+    args = parser.parse_args(argv)
+
+    trades = load_trades(args.trades)
+    print(format_report(realized_pnl(trades, args.year, args.month), args.year, args.month))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
