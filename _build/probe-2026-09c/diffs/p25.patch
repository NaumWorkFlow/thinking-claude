diff --git a/tests/test_report.py b/tests/test_report.py
new file mode 100644
index 0000000..21c2da2
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,181 @@
+import io
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from datetime import date
+from pathlib import Path
+
+from app.report import format_report, main, realized_pnl
+from app.trades import Trade, load_trades
+
+DATA = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def trade(trade_id, day, ticker, side, qty, price, currency="USD", fee=0.0):
+    return Trade(
+        trade_id=trade_id,
+        date=date.fromisoformat(day),
+        ticker=ticker,
+        side=side,
+        qty=qty,
+        price=price,
+        currency=currency,
+        fee=fee,
+    )
+
+
+class TestRealizedPnl(unittest.TestCase):
+    def test_full_sale_of_one_lot_includes_both_fees(self):
+        trades = [
+            trade(1, "2026-08-01", "X", "BUY", 10, 100.0, fee=1.0),
+            trade(2, "2026-09-01", "X", "SELL", 10, 110.0, fee=1.0),
+        ]
+        # proceeds 1100 - 1 = 1099; cost 1000 + 1 = 1001
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 98.0})
+
+    def test_partial_sale_spreads_purchase_fee_over_units(self):
+        trades = [
+            trade(1, "2026-08-01", "X", "BUY", 10, 100.0, fee=2.0),
+            trade(2, "2026-09-01", "X", "SELL", 4, 120.0, fee=1.0),
+        ]
+        # cost per unit 100.2; proceeds 480 - 1 = 479; cost 400.8
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 78.2)
+
+    def test_fifo_across_two_lots(self):
+        trades = [
+            trade(1, "2026-08-01", "X", "BUY", 5, 100.0),
+            trade(2, "2026-08-02", "X", "BUY", 5, 200.0),
+            trade(3, "2026-09-01", "X", "SELL", 7, 300.0),
+        ]
+        # 5 @ 100 + 2 @ 200 = 900 cost; proceeds 2100
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 1200.0)
+
+    def test_matching_is_chronological_not_file_order(self):
+        trades = [
+            trade(3, "2026-09-01", "X", "SELL", 5, 300.0),
+            trade(2, "2026-08-02", "X", "BUY", 5, 200.0),
+            trade(1, "2026-08-01", "X", "BUY", 5, 100.0),
+        ]
+        # FIFO by date: the 100-lot goes first, not the 200-lot.
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 1000.0)
+
+    def test_only_sales_in_the_month_are_reported(self):
+        trades = [
+            trade(1, "2026-07-01", "X", "BUY", 10, 100.0),
+            trade(2, "2026-08-01", "X", "SELL", 5, 150.0),
+            trade(3, "2026-09-01", "X", "SELL", 5, 200.0),
+            trade(4, "2026-10-01", "X", "SELL", 1, 250.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 8), {"X": 250.0})
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 500.0})
+        # Sale in October exceeds what is left -> unknown, but only for October.
+        self.assertEqual(realized_pnl(trades, 2026, 10), {"X": None})
+
+    def test_earlier_sale_consumes_lots_for_later_month(self):
+        trades = [
+            trade(1, "2026-07-01", "X", "BUY", 5, 100.0),
+            trade(2, "2026-07-02", "X", "BUY", 5, 200.0),
+            trade(3, "2026-08-01", "X", "SELL", 5, 150.0),
+            trade(4, "2026-09-01", "X", "SELL", 5, 250.0),
+        ]
+        # August took the 100-lot; September sells the 200-lot.
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 250.0)
+
+    def test_purchase_later_in_month_does_not_cover_earlier_sale(self):
+        trades = [
+            trade(1, "2026-09-05", "X", "SELL", 3, 100.0),
+            trade(2, "2026-09-20", "X", "BUY", 3, 50.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": None})
+
+    def test_sale_without_any_purchase_is_unknown_not_profit(self):
+        trades = [trade(1, "2026-09-12", "TSLA", "SELL", 3, 250.0, fee=1.0)]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"TSLA": None})
+
+    def test_sale_exceeding_holdings_is_unknown(self):
+        trades = [
+            trade(1, "2026-08-01", "X", "BUY", 2, 100.0),
+            trade(2, "2026-09-01", "X", "SELL", 3, 100.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": None})
+
+    def test_unknown_ticker_stays_unknown_after_a_matched_sale(self):
+        trades = [
+            trade(1, "2026-09-01", "X", "SELL", 1, 100.0),
+            trade(2, "2026-09-02", "X", "BUY", 1, 50.0),
+            trade(3, "2026-09-03", "X", "SELL", 1, 100.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": None})
+
+    def test_converts_to_usd(self):
+        trades = [
+            trade(1, "2026-08-01", "SAP", "BUY", 20, 150.0, "EUR", fee=2.0),
+            trade(2, "2026-09-01", "SAP", "SELL", 20, 160.0, "EUR", fee=2.0),
+        ]
+        # 196 EUR * 1.08
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["SAP"], 211.68)
+
+    def test_several_tickers_are_independent(self):
+        trades = [
+            trade(1, "2026-08-01", "A", "BUY", 1, 10.0),
+            trade(2, "2026-08-01", "B", "BUY", 1, 10.0),
+            trade(3, "2026-09-01", "A", "SELL", 1, 15.0),
+            trade(4, "2026-09-01", "B", "SELL", 1, 5.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"A": 5.0, "B": -5.0})
+
+    def test_no_sales_in_month_gives_empty_dict(self):
+        trades = [trade(1, "2026-08-01", "X", "BUY", 1, 10.0)]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {})
+
+    def test_unknown_side_raises(self):
+        trades = [trade(1, "2026-09-01", "X", "SHORT", 1, 10.0)]
+        with self.assertRaises(ValueError):
+            realized_pnl(trades, 2026, 9)
+
+    def test_sample_file_september_2026(self):
+        pnl = realized_pnl(load_trades(DATA), 2026, 9)
+        self.assertEqual(set(pnl), {"AAPL", "SAP", "MAIB", "TSLA"})
+        # AAPL: sell 5 (48.5) + sell 6 across two lots (113.3)
+        self.assertAlmostEqual(pnl["AAPL"], 161.8)
+        self.assertAlmostEqual(pnl["SAP"], 211.68)
+        # 742.5 MDL / 17.8
+        self.assertAlmostEqual(pnl["MAIB"], 742.5 / 17.8)
+        self.assertIsNone(pnl["TSLA"])
+
+
+class TestReportCli(unittest.TestCase):
+    def run_cli(self, *argv):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            code = main(list(argv))
+        return code, out.getvalue()
+
+    def test_prints_table_and_total(self):
+        code, out = self.run_cli("2026", "9")
+        self.assertEqual(code, 0)
+        self.assertIn("2026-09", out)
+        self.assertIn("AAPL", out)
+        self.assertIn("161.80", out)
+        self.assertIn("Итого", out)
+        self.assertIn("TSLA", out)
+        self.assertIn("n/a", out)
+
+    def test_month_without_sales(self):
+        code, out = self.run_cli("2026", "7")
+        self.assertEqual(code, 0)
+        self.assertIn("нет", out)
+
+    def test_rejects_bad_month(self):
+        with self.assertRaises(SystemExit):
+            with redirect_stderr(io.StringIO()):
+                main(["2026", "13"])
+
+    def test_format_report_total_excludes_unknown(self):
+        text = format_report({"A": 10.0, "B": None, "C": -2.5}, 2026, 9)
+        self.assertIn("7.50", text)
+        self.assertIn("Итого*", text)
+        self.assertIn("без B", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
