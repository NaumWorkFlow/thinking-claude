diff --git a/app/report.py b/app/report.py
index 5fe7f83..10231ca 100644
--- a/app/report.py
+++ b/app/report.py
@@ -1 +1,129 @@
-"""Portfolio reports."""
+"""Portfolio reports.
+
+Realized P&L per ticker for the sells of one calendar month.
+
+Cost basis is FIFO: every sell is matched against the earliest open lots of
+the same ticker, across the whole trade history (a lot bought in August can
+be closed in September). Fees are part of the result: a buy fee raises the
+lot's cost, a sell fee lowers the proceeds. Each leg is converted to USD with
+``app.fx.to_usd``.
+
+A sell for which the history holds no lot (the position was opened before the
+export starts) has no cost basis. Its uncovered quantity is left out of
+``realized_pnl`` and listed by ``unmatched_sells`` instead of being counted
+as pure profit.
+"""
+
+import argparse
+import sys
+from collections import defaultdict, deque
+from pathlib import Path
+
+from app.fx import to_usd
+from app.trades import load_trades
+
+DEFAULT_TRADES = Path(__file__).resolve().parent.parent / "data" / "trades.csv"
+
+
+def _replay(trades):
+    """Replay the whole history and yield ``(sell, covered_qty, pnl_usd)``.
+
+    ``pnl_usd`` is the realized P&L of the covered part of ``sell``; the
+    sell fee is charged in proportion to the covered quantity.
+    """
+    lots = defaultdict(deque)  # ticker -> deque of [qty, cost_per_share_usd]
+    for t in sorted(trades, key=lambda t: (t.date, t.trade_id)):
+        if t.side == "BUY":
+            cost = to_usd(t.qty * t.price + t.fee, t.currency)
+            lots[t.ticker].append([t.qty, cost / t.qty])
+        elif t.side == "SELL":
+            remaining = t.qty
+            cost = 0.0
+            queue = lots[t.ticker]
+            while remaining and queue:
+                lot = queue[0]
+                take = min(remaining, lot[0])
+                cost += take * lot[1]
+                lot[0] -= take
+                remaining -= take
+                if lot[0] == 0:
+                    queue.popleft()
+            covered = t.qty - remaining
+            if covered:
+                proceeds = to_usd(
+                    covered * t.price - t.fee * covered / t.qty, t.currency
+                )
+                yield t, covered, proceeds - cost
+            else:
+                yield t, 0, 0.0
+        else:
+            raise ValueError(f"trade {t.trade_id}: unknown side {t.side!r}")
+
+
+def _in_month(trade, year, month):
+    return trade.date.year == year and trade.date.month == month
+
+
+def realized_pnl(trades, year, month):
+    """Return ``{ticker: realized P&L in USD}`` for the sells of that month.
+
+    Only the covered part of each sell is counted; see ``unmatched_sells``
+    for the quantities that have no cost basis in the data.
+    """
+    result = defaultdict(float)
+    for sell, covered, pnl in _replay(trades):
+        if covered and _in_month(sell, year, month):
+            result[sell.ticker] += pnl
+    return dict(result)
+
+
+def unmatched_sells(trades, year, month):
+    """Return ``[(sell, uncovered_qty)]`` for that month's sells lacking a lot."""
+    return [
+        (sell, sell.qty - covered)
+        for sell, covered, _ in _replay(trades)
+        if covered < sell.qty and _in_month(sell, year, month)
+    ]
+
+
+def format_report(pnl, unmatched, year, month):
+    """Render the P&L table, its total and the unmatched sells as text."""
+    lines = [f"Реализованная прибыль за {year}-{month:02d}, USD", ""]
+    width = max([len("Тикер"), *(len(t) for t in pnl)])
+    lines.append(f"{'Тикер':<{width}}  {'P&L':>12}")
+    for ticker in sorted(pnl):
+        lines.append(f"{ticker:<{width}}  {pnl[ticker]:>12.2f}")
+    lines.append("-" * (width + 14))
+    lines.append(f"{'Итого':<{width}}  {sum(pnl.values()):>12.2f}")
+    if unmatched:
+        lines.append("")
+        lines.append("Не учтено — нет покупки в данных (себестоимость неизвестна):")
+        for sell, qty in unmatched:
+            lines.append(
+                f"  {sell.ticker}: продажа {qty} шт. {sell.date.isoformat()}"
+                f" по {sell.price:.2f} {sell.currency}"
+            )
+    return "\n".join(lines)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        prog="python -m app.report",
+        description="Реализованная прибыль по тикерам за месяц.",
+    )
+    parser.add_argument("year", type=int)
+    parser.add_argument("month", type=int, choices=range(1, 13), metavar="month")
+    parser.add_argument(
+        "--trades", type=Path, default=DEFAULT_TRADES, help="CSV со сделками"
+    )
+    args = parser.parse_args(argv)
+
+    trades = load_trades(args.trades)
+    pnl = realized_pnl(trades, args.year, args.month)
+    unmatched = unmatched_sells(trades, args.year, args.month)
+    print(format_report(pnl, unmatched, args.year, args.month))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
