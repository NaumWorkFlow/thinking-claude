diff --git a/tests/test_report.py b/tests/test_report.py
new file mode 100644
index 0000000..ffe3dce
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,124 @@
+import subprocess
+import sys
+import unittest
+from datetime import date
+from pathlib import Path
+
+from app.report import format_report, realized_pnl, unmatched_sells
+from app.trades import Trade, load_trades
+
+ROOT = Path(__file__).resolve().parent.parent
+DATA = ROOT / "data" / "trades.csv"
+
+
+def trade(trade_id, day, ticker, side, qty, price, currency="USD", fee=0.0):
+    return Trade(trade_id, date.fromisoformat(day), ticker, side, qty, price, currency, fee)
+
+
+class TestRealizedPnl(unittest.TestCase):
+    def test_fifo_across_months_with_fees(self):
+        # Aug lot: 10 @ 180 + 1 fee -> 180.10/share.
+        # Sep 3: sell 5 @ 190 - 1 fee -> 949 - 900.50 = 48.50.
+        # Sep 15 lot: 5 @ 185 + 1 fee -> 185.20/share.
+        # Sep 25: sell 6 @ 200 - 1 fee -> 1199 - (5*180.10 + 185.20) = 113.30.
+        trades = [
+            trade(1, "2026-08-20", "AAPL", "BUY", 10, 180.0, fee=1.0),
+            trade(2, "2026-09-03", "AAPL", "SELL", 5, 190.0, fee=1.0),
+            trade(3, "2026-09-15", "AAPL", "BUY", 5, 185.0, fee=1.0),
+            trade(4, "2026-09-25", "AAPL", "SELL", 6, 200.0, fee=1.0),
+        ]
+        pnl = realized_pnl(trades, 2026, 9)
+        self.assertEqual(set(pnl), {"AAPL"})
+        self.assertAlmostEqual(pnl["AAPL"], 161.80)
+
+    def test_only_sells_of_that_month_are_counted(self):
+        trades = [
+            trade(1, "2026-08-01", "X", "BUY", 10, 10.0),
+            trade(2, "2026-08-15", "X", "SELL", 4, 20.0),  # August: consumes lots, not reported
+            trade(3, "2026-09-10", "X", "SELL", 6, 30.0),  # September: 6 * (30 - 10)
+            trade(4, "2026-09-20", "Y", "BUY", 1, 5.0),  # a buy alone realizes nothing
+            trade(5, "2026-10-01", "Y", "SELL", 1, 9.0),  # October: not September's
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 120.0})
+        self.assertEqual(realized_pnl(trades, 2026, 8), {"X": 40.0})
+        self.assertEqual(realized_pnl(trades, 2026, 10), {"Y": 4.0})
+        self.assertEqual(realized_pnl(trades, 2026, 7), {})
+
+    def test_sells_are_matched_in_date_order_not_file_order(self):
+        trades = [
+            trade(2, "2026-09-05", "X", "SELL", 1, 50.0),
+            trade(1, "2026-09-01", "X", "BUY", 1, 20.0),
+        ]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {"X": 30.0})
+
+    def test_each_leg_is_converted_to_usd(self):
+        # 20 * (160 - 150) EUR - 2 - 2 fee = 196 EUR = 211.68 USD at 1.08.
+        trades = [
+            trade(1, "2026-09-05", "SAP", "BUY", 20, 150.0, "EUR", 2.0),
+            trade(2, "2026-09-18", "SAP", "SELL", 20, 160.0, "EUR", 2.0),
+        ]
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["SAP"], 211.68)
+
+    def test_sell_without_any_lot_is_excluded_and_listed(self):
+        trades = [trade(1, "2026-09-12", "TSLA", "SELL", 3, 250.0, fee=1.0)]
+        self.assertEqual(realized_pnl(trades, 2026, 9), {})
+        [(sell, qty)] = unmatched_sells(trades, 2026, 9)
+        self.assertEqual((sell.ticker, qty), ("TSLA", 3))
+
+    def test_partially_covered_sell(self):
+        # 2 shares covered: 2 * (15 - 10) minus 2/5 of the 5.0 sell fee = 8.0.
+        trades = [
+            trade(1, "2026-09-01", "X", "BUY", 2, 10.0),
+            trade(2, "2026-09-02", "X", "SELL", 5, 15.0, fee=5.0),
+        ]
+        self.assertAlmostEqual(realized_pnl(trades, 2026, 9)["X"], 8.0)
+        [(sell, qty)] = unmatched_sells(trades, 2026, 9)
+        self.assertEqual((sell.trade_id, qty), (2, 3))
+
+    def test_unmatched_sells_of_other_months_are_not_listed(self):
+        trades = [trade(1, "2026-08-12", "TSLA", "SELL", 3, 250.0)]
+        self.assertEqual(unmatched_sells(trades, 2026, 9), [])
+
+    def test_unknown_side_is_rejected(self):
+        with self.assertRaises(ValueError):
+            realized_pnl([trade(1, "2026-09-01", "X", "SHORT", 1, 1.0)], 2026, 9)
+
+
+class TestRealData(unittest.TestCase):
+    def test_september_2026(self):
+        trades = load_trades(DATA)
+        pnl = realized_pnl(trades, 2026, 9)
+        self.assertEqual(set(pnl), {"AAPL", "SAP", "MAIB"})
+        self.assertAlmostEqual(pnl["AAPL"], 161.80)
+        self.assertAlmostEqual(pnl["SAP"], 211.68)
+        self.assertAlmostEqual(pnl["MAIB"], 742.5 / 17.8)  # 742.50 MDL
+        self.assertAlmostEqual(sum(pnl.values()), 415.19, places=2)
+        [(sell, qty)] = unmatched_sells(trades, 2026, 9)
+        self.assertEqual((sell.ticker, qty), ("TSLA", 3))
+
+    def test_format_report(self):
+        trades = load_trades(DATA)
+        text = format_report(
+            realized_pnl(trades, 2026, 9), unmatched_sells(trades, 2026, 9), 2026, 9
+        )
+        self.assertIn("2026-09", text)
+        self.assertIn("415.19", text)
+        self.assertIn("TSLA", text)
+
+
+class TestCli(unittest.TestCase):
+    def test_module_runs_from_project_root(self):
+        result = subprocess.run(
+            [sys.executable, "-m", "app.report", "2026", "9"],
+            cwd=ROOT,
+            capture_output=True,
+            text=True,
+            check=True,
+        )
+        self.assertIn("Итого", result.stdout)
+        self.assertIn("415.19", result.stdout)
+        self.assertIn("TSLA", result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
