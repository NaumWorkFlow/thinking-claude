     def test_eur(self):
         self.assertAlmostEqual(to_usd(100, "EUR"), 108.0)
 
+    def test_mdl_is_weaker_than_usd(self):
+        # 1 USD ≈ 17.8 MDL, so 17.8 MDL must come back as about one dollar.
+        self.assertAlmostEqual(to_usd(17.8, "MDL"), 1.0)
